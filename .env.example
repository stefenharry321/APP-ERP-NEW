# SUPABASE_URL: Your Supabase project URL connected to the Kumar Foods Windows ERP
# Example: https://your-project-ref.supabase.co
# Configure this in the Secrets panel in AI Studio.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# SUPABASE_ANON_KEY: Your Supabase anon/public API key for real-time ERP sync.
# Configure this in the Secrets panel in AI Studio.
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
